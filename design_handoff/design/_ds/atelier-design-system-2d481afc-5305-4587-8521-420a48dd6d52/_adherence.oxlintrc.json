{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/stats/**",
              "components/status/**",
              "components/wardrobe/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|Cormorant Garamond))/i]",
        "message": "Font not provided by the design system. Available: Onest, Cormorant Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|image|icon|layout|selected|disabled|error|pressed|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AnswerCard> doesn't accept that prop. Declared props: title, subtitle, image, icon, layout, selected, disabled, error, pressed, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|tile)$/]",
        "message": "<AnswerCard> layout must be one of 'row' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|trend|trendIcon|align|size|glow|color|style|key|ref|className|style|children)$/]",
        "message": "<BigStat> doesn't accept that prop. Declared props: value, unit, label, trend, trendIcon, align, size, glow, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<BigStat> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md)$/]",
        "message": "<BigStat> size must be one of 'xl' | 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigTextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|placeholder|suggestions|onChange|onSuggestion|error|disabled|focused|style|key|ref|className|style|children)$/]",
        "message": "<BigTextField> doesn't accept that prop. Declared props: value, defaultValue, placeholder, suggestions, onChange, onSuggestion, error, disabled, focused, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|footer|animated|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: title, subtitle, children, footer, animated, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|icon|iconRight|disabled|pressed|loading|glass|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, icon, iconRight, disabled, pressed, loading, glass, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."

{
  "name": "atelier-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build-legal.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "pwa-icons": "node scripts/build-pwa-icons.mjs",
    "video:stage": "npm run build && node tools/build-stage.mjs",
    "video:record": "node tools/record-video.mjs video/out",
    "video:audio": "python3 tools/make-audio.py video/stage/music.wav 60.5",
    "video:encode": "tools/encode-video.sh video/out video/stage/music.wav video/atelier-demo.mp4",
    "legal": "node tools/build-legal.mjs",
    "shots": "node tools/shots.mjs",
    "android:sync": "vite build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:assets": "node scripts/build-android-assets.mjs",
    "server": "cd server && npm start",
    "server:test": "cd server && npm test"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "framer-motion": "^14.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}

# Скопируй в .env и заполни. Без .env сервер стартует в режиме разработки (коды входа печатаются в консоль, оплата и AI выключены)
NODE_ENV=production
PORT=8787
# Сайт, с которого идут запросы (для CORS). В проде сайт и API на одном домене, тогда можно оставить пустым
CORS_ORIGIN=
# Секрет для подписи токенов входа. Сгенерировать: openssl rand -hex 32
TOKEN_SECRET=
# Где лежат данные (JSON-база, фото, события). Должна переживать перезапуски и обновления
DATA_DIR=./data
# Откуда отдавать собранный сайт (папка dist). Пусто: сайт отдаёт nginx
STATIC_DIR=

# Почта для кодов входа. MAIL_MODE=log печатает код в консоль (только для разработки), smtp отправляет письмо
MAIL_MODE=smtp
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@your-domain.ru
SMTP_PASS=
MAIL_FROM="Atelier <no-reply@your-domain.ru>"

# AI: none | gigachat | yandex | openai (любой OpenAI-совместимый: OpenRouter, DeepSeek, Groq, Ollama)
AI_PROVIDER=none
# GigaChat (https://developers.sber.ru/studio): ключ авторизации (Authorization key), scope и модель
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Yandex AI Studio: API-ключ сервисного аккаунта и идентификатор каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
# OpenAI-совместимый провайдер
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Модель с картинками для описания вещи по фото (необязательно, без неё карточку заполняет клиент по шаблону)
OPENAI_VISION_MODEL=
# Адрес сервиса вырезания фона (rembg / BiRefNet), см. docs/AI.md. Пусто: фон не вырезается
CUTOUT_URL=
AI_TIMEOUT_MS=20000

# CloudPayments (личный кабинет, раздел «Сайты»): ID терминала (pk_… или test_api_…) и пароль для API
CP_PUBLIC_ID=
CP_API_SECRET=
# Цены тарифов в рублях (источник правды на сервере, клиенту доверять нельзя)
PRICE_SUB=300
PRICE_PLUS=600
# Налоги для чека 54-ФЗ: система налогообложения (0 ОСН, 1 УСН доход, 2 УСН доход-расход, 3 ЕНВД, 4 ЕСХН, 5 патент) и НДС (null без НДС, 0, 10, 20)
CP_TAXATION=1
CP_VAT=
